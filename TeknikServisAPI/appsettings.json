{
  "ConnectionStrings": {
    "DefaultConnection": "TO_BE_SET_IN_USER_SECRETS_OR_ENV",
    "HangfireConnection": "TO_BE_SET_IN_USER_SECRETS_OR_ENV"
  },
  "JwtSettings": {
    "SecretKey": "TO_BE_SET_IN_USER_SECRETS_OR_ENV",
    "Issuer": "TeknikServisAPI",
    "Audience": "TeknikServisClient",
    "ExpirationHours": 24,
    "AccessTokenExpirationMinutes": 30,
    "RefreshTokenExpirationDays": 7
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Hangfire": "Information"
    }
  },
  "AllowedHosts": "localhost",
  "AllowedOrigins": [
    "http://localhost:3000"
  ],
  "AllowedMethods": [
    "GET",
    "POST",
    "PUT",
    "DELETE",
    "PATCH"
  ],
  "AllowedHeaders": [
    "Authorization",
    "Content-Type",
    "Accept",
    "X-Requested-With"
  ],
  "AdminBootstrap": {
    "Enabled": false,
    "SeedEnabled": false,
    "Secret": "TO_BE_SET_IN_USER_SECRETS_OR_ENV",
    "Password": "TO_BE_SET_IN_USER_SECRETS_OR_ENV"
  },
  "Swagger": {
    "Enabled": false
  },
  "Hangfire": {
    "UseMemoryStorage": false,
    "TablesPrefix": "Hangfire"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{CorrelationId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "QuotaExceededMessage": "İstek limiti aşıldı. Lütfen {0} sonra tekrar deneyin.",
    "IpWhitelist": [],
    "EndpointWhitelist": [],
    "ClientWhitelist": [],
    "GeneralRules": [
      {
        "Endpoint": "*:/api/auth/login*",
        "Period": "1m",
        "Limit": 5
      },
      {
        "Endpoint": "*:/api/auth/login-v2*",
        "Period": "1m",
        "Limit": 5
      },
      {
        "Endpoint": "*:/api/v1/auth/login*",
        "Period": "1m",
        "Limit": 5
      },
      {
        "Endpoint": "*:/api/auth/refresh-token*",
        "Period": "1m",
        "Limit": 10
      },
      {
        "Endpoint": "*:/api/v1/auth/refresh-token*",
        "Period": "1m",
        "Limit": 10
      },
      {
        "Endpoint": "*:/api/auth/create-admin*",
        "Period": "1h",
        "Limit": 2
      },
      {
        "Endpoint": "*:/api/v1/auth/create-admin*",
        "Period": "1h",
        "Limit": 2
      }
    ]
  }
}
